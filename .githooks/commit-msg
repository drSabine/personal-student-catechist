#!/bin/sh
# Checks the commit message. See docs/workflow.md for the format.

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Let git's own messages through (merges, reverts, fixups).
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z0-9-]+\))?: .{3,}$'; then
  echo "Commit message must look like: type: short summary"
  echo "  types: feat fix docs style refactor perf test build ci chore"
  echo "  example: feat(lesson-02): add the lesson 2 photo wall"
  echo "Yours: $first_line"
  exit 1
fi

if [ ${#first_line} -gt 72 ]; then
  echo "Keep the first line to 72 characters or fewer (yours is ${#first_line})."
  exit 1
fi

if grep -qi '^co-authored-by:' "$msg_file"; then
  echo "No Co-Authored-By lines in this project."
  exit 1
fi
